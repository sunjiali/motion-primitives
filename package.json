{
  "author": "Robin (sunjiali)",
  "bin": {
    "motion-primitives": "src/render.js"
  },
  "bugs": {
    "url": "https://github.com/sunjiali/motion-primitives/issues"
  },
  "dependencies": {
    "puppeteer-core": "^25.14.0"
  },
  "description": "Frame-pure motion primitives for AI-generated videos: tiny building blocks (pop, fly, beat, camera, meshBg…) an AI composes instead of hand-writing animation math. Ships a headless-Chrome + ffmpeg renderer and a code-synthesized SFX engine.",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./index.js": "./index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/lib",
    "src/render.js",
    "src/studio.js",
    "src/sfx.js",
    "src/player.html",
    "src/compositions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://sunjiali.github.io/motion-primitives/",
  "keywords": [
    "animation",
    "motion",
    "motion-graphics",
    "video",
    "ai-video",
    "explainer-video",
    "ffmpeg",
    "headless-chrome",
    "primitives",
    "remotion"
  ],
  "license": "MIT",
  "main": "index.js",
  "name": "@sunjiali/motion-primitives",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunjiali/motion-primitives.git"
  },
  "scripts": {
    "check": "npm run typecheck && npm run syntax && npm test",
    "pack:check": "npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.js",
    "prepublishOnly": "npm run check",
    "render": "node src/render.js",
    "syntax": "node scripts/check-syntax.js",
    "test": "node --test",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": [
    "./index.js",
    "./src/lib/animation.js",
    "./src/lib/captions.js",
    "./src/lib/primitives.js"
  ],
  "type": "commonjs",
  "types": "index.d.ts",
  "version": "0.24.0"
}
